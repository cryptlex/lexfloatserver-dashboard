{
    "name": "lexfloatserver-dashboard",
    "version": "1.0.0",
    "private": true,
    "description": "LexFloatServer Dashboard",
    "author": "Cryptlex Team",
    "type": "module",
    "packageManager": "pnpm@12.11.0",
    "scripts": {
        "dev": "vite",
        "build": "vite build && tsc -b",
        "preview": "vite preview",
        "generate:api": "openapi-typescript swagger.json -o src/lib/api-schema.d.ts",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "format": "biome format --write .",
        "check": "biome check --write .",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx,json,mts,css}": [
            "biome check --write --no-errors-on-unmatched"
        ]
    },
    "dependencies": {
        "@cryptlex/web-components": "6.8.3",
        "@tailwindcss/vite": "4.3.3",
        "@tanstack/react-query": "5.102.7",
        "@tanstack/react-router": "1.170.32",
        "@tanstack/react-table": "8.21.3",
        "jwt-decode": "4.0.0",
        "openapi-fetch": "0.17.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "tailwindcss": "4.3.3",
        "tailwindcss-react-aria-components": "2.2.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.10",
        "@inlang/paraglide-js": "2.25.0",
        "@tanstack/react-query-devtools": "5.102.7",
        "@tanstack/react-router-devtools": "1.167.1",
        "@tanstack/router-plugin": "1.168.35",
        "@types/node": "22.19.1",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.5",
        "@vitejs/plugin-react": "6.1.0",
        "husky": "9.1.7",
        "lint-staged": "15.2.10",
        "openapi-typescript": "7.13.0",
        "typescript": "5.8.3",
        "vite": "8.2.2"
    }
}
